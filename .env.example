# Copy to .env and fill in. .env is git-ignored.

# REQUIRED. Must match the key the ZAP daemon is started with. There is no
# default; the server refuses to start without it (unless ZAP_ALLOW_INSECURE).
ZAP_API_KEY=change-me-to-a-long-random-value

# --- Optional: engagement scope controls for attack-capable tools -----------
# Comma-separated host suffixes that may be actively scanned/crawled. Leave
# empty to allow any target (metadata endpoints are always blocked regardless).
# Example: ZAP_TARGET_ALLOWLIST=example.com,staging.example.org
ZAP_TARGET_ALLOWLIST=

# Refuse attacks against private/loopback/link-local addresses. Keep false for
# local test labs (juice-shop, DVWA, bodgeit); set true for internet-only scope.
ZAP_BLOCK_PRIVATE_TARGETS=false

# --- Optional: connection / reliability tuning ------------------------------
# ZAP_BASE_URL=http://zap:8080
# REQUEST_TIMEOUT=60
# CONNECT_TIMEOUT=10
# ZAP_MAX_RETRIES=2
# ZAP_RETRY_BACKOFF=0.5
# Report/import directory. Must be a path on the volume shared between the ZAP
# and MCP containers (compose mounts `zap-wrk` at /zap/wrk in both), because ZAP
# resolves API file paths against its own filesystem.
# ZAP_REPORT_DIR=/zap/wrk

# --- Development only --------------------------------------------------------
# Allow the server to start without an API key (INSECURE; local dev only).
# ZAP_ALLOW_INSECURE=false
