# syntax=docker/dockerfile:1
#
# OPTIONAL all-in-one image: OWASP ZAP + the MCP server in a single container.
#
# This exists to make trying the project a two-liner:
#
#   docker build -f Dockerfile.allinone -t zap-mcp-server:all-in-one .
#   docker run -d -p 127.0.0.1:8000:8000 zap-mcp-server:all-in-one
#
# No .env file and no API key to invent: ZAP's API is bound to loopback inside the
# container and its key is generated at startup, so it is an internal detail
# rather than a credential the user has to manage.
#
# ---------------------------------------------------------------------------
# For sustained/production use prefer `docker compose up -d` (see README).
# The two-service layout keeps ZAP independently upgradable, lets you restart the
# MCP server without destroying a live scan session, and reports separate health
# per component. This image trades those properties for install convenience.
# ---------------------------------------------------------------------------
#
# Both processes are supervised by s6-overlay, which as PID 1 reaps orphaned
# children, forwards signals, orders startup, and (via the readiness gate in the
# zap service) guarantees the MCP server only starts once the ZAP API answers.

FROM zaproxy/zap-stable:2.17.0

# s6-overlay must unpack and run its supervision tree as root at PID 1. The
# individual services drop back to the unprivileged `zap` user (uid 1000) via
# s6-setuidgid, so neither ZAP nor the MCP server runs as root.
USER root

# --- s6-overlay -------------------------------------------------------------
# Pinned and checksum-verified: this image can launch attack traffic, so the
# supervisor binary is not fetched unpinned from the network.
ARG S6_OVERLAY_VERSION=3.2.3.2
ARG S6_NOARCH_SHA256=5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12
ARG S6_X86_64_SHA256=e6befcc96a437a3831386ecfc51808c5d3e939dc5fe3c02ae9284599e8aa2408
ARG S6_AARCH64_SHA256=b17f17a82e7a515c682a91edaf2ffdabb73f891981b6c1fd712115693a2f8b4c
ARG TARGETARCH

RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64)  s6_arch=x86_64;  s6_sha="${S6_X86_64_SHA256}"  ;; \
      arm64)  s6_arch=aarch64; s6_sha="${S6_AARCH64_SHA256}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}"; \
    curl -fsSL -o /tmp/s6-noarch.tar.xz "${base}/s6-overlay-noarch.tar.xz"; \
    curl -fsSL -o /tmp/s6-arch.tar.xz   "${base}/s6-overlay-${s6_arch}.tar.xz"; \
    echo "${S6_NOARCH_SHA256}  /tmp/s6-noarch.tar.xz" | sha256sum -c -; \
    echo "${s6_sha}  /tmp/s6-arch.tar.xz"             | sha256sum -c -; \
    tar -C / -Jxpf /tmp/s6-noarch.tar.xz; \
    tar -C / -Jxpf /tmp/s6-arch.tar.xz; \
    rm -f /tmp/s6-noarch.tar.xz /tmp/s6-arch.tar.xz

# --- Python dependencies ----------------------------------------------------
# Debian 12 marks its system Python as externally managed (PEP 668), so the app
# gets its own virtualenv rather than --break-system-packages. The base image
# ships python3.11 but not ensurepip, so python3.11-venv is required for
# `python3 -m venv` to succeed.
ENV VIRTUAL_ENV=/opt/zap-mcp
COPY requirements.txt /tmp/requirements.txt
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends python3.11-venv; \
    rm -rf /var/lib/apt/lists/*; \
    python3 -m venv "${VIRTUAL_ENV}"; \
    "${VIRTUAL_ENV}/bin/pip" install --no-cache-dir --upgrade pip; \
    "${VIRTUAL_ENV}/bin/pip" install --no-cache-dir -r /tmp/requirements.txt; \
    rm -f /tmp/requirements.txt

# --- Application source -----------------------------------------------------
WORKDIR /app
COPY config.py policy.py zap_client.py server.py ./
COPY tools/ ./tools/

# --- Supervision tree -------------------------------------------------------
COPY docker/allinone/rootfs /

RUN set -eux; \
    chmod +x /etc/s6-overlay/s6-rc.d/zap/run \
             /etc/s6-overlay/s6-rc.d/mcp-server/run \
             /etc/s6-overlay/scripts/* \
             /usr/local/bin/allinone-healthcheck; \
    # Reports and file-based imports land here. Single filesystem, so unlike the
    # compose setup no volume sharing is needed for these to work.
    mkdir -p /zap/wrk; \
    chown -R zap:zap /zap/wrk /app; \
    # s6 writes runtime state here; the container may be run read-only-ish.
    mkdir -p /run/s6 && chmod 0755 /run/s6

# Only the MCP port is published. ZAP's API listens on 127.0.0.1 inside the
# container and is unreachable from outside it by design.
EXPOSE 8000

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ZAP_BASE_URL="http://127.0.0.1:8080" \
    MCP_HOST="0.0.0.0" \
    MCP_PORT="8000" \
    ZAP_REPORT_DIR="/zap/wrk" \
    ZAP_TARGET_ALLOWLIST="" \
    ZAP_BLOCK_PRIVATE_TARGETS="false"

# S6_BEHAVIOUR_IF_STAGE2_FAILS=2 -> tear the container down if a supervised
# service fails to start, rather than running degraded (e.g. MCP alive, ZAP dead).
# S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 -> wait indefinitely for the readiness gate,
# since a cold ZAP/JVM start on a slow host can take well over a minute.
# The GRACETIME values are deliberately kept well under `docker stop`'s default
# 10s SIGKILL deadline: if s6's own shutdown budget exceeds it, Docker kills the
# supervisor mid-teardown and the container reports exit 137 instead of 0.
ENV S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_SERVICES_GRACETIME=4000 \
    S6_KILL_GRACETIME=2000 \
    S6_KILL_FINISH_MAXTIME=3000

# Healthy only when BOTH components answer: ZAP's API and the MCP endpoint.
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD /usr/local/bin/allinone-healthcheck

ENTRYPOINT ["/init"]
